{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/download", "destination": "https://github.com/Advankart/vitalnest/releases/latest/download/VitalNest.apk", "permanent": false },
    { "source": "/download-compat", "destination": "https://github.com/Advankart/vitalnest/releases/latest/download/VitalNest-compat.apk", "permanent": false }
  ],
  "rewrites": [{ "source": "/((?!assets/|sw.js|workbox-|manifest.webmanifest|icon-|favicon|apple-touch).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
